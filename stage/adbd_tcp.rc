service absshd /odm/bin/absshd -addr 0.0.0.0:2222 -authorized_keys /odm/etc/absshd/authorized_keys -log /data/local/tmp/absshd/sshd.log
    class main
    user root
    group root
    seclabel u:r:shell:s0
    oneshot
    disabled

service adbguard /system/bin/sh /odm/bin/adbguard.sh
    class main
    user root
    group root
    seclabel u:r:shell:s0
    disabled

service stationweb /odm/bin/station-web -config /odm/etc/station-web.conf
    class main
    user root
    group root
    seclabel u:r:shell:s0
    oneshot
    disabled

service stationguard /system/bin/sh /odm/bin/station-guard.sh
    class main
    user root
    group root
    seclabel u:r:shell:s0
    disabled

on property:sys.boot_completed=1
    setprop service.adb.tcp.port 5555
    start adbguard
    start absshd
    start stationweb
    start stationguard
